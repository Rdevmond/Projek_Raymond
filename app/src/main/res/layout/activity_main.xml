<!--
    =============================================================================
    ROOT LAYOUT: CONSTRAINTLAYOUT
    =============================================================================
    ConstraintLayout menyusun semua komponen (Header, Toolbar, ChipGroup,
    Container Fragment, dan BottomNav) secara flat tanpa hierarki bersarang.
    Tiap view diikat (constrained) ke sisi layar atau ke view lainnya.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blueish"
    tools:context=".MainActivity">

    <!-- Header dekoratif bergaya gelombang (bg_header_wave) — berada di belakang Toolbar -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Toolbar: ActionBar utama halaman utama.
        - Diatur oleh MainActivity.kt via setSupportActionBar(binding.toolbar)
        - Menu toolbar (Search, Settings, Profile) ada di res/menu/main_menu.xml
        - Klik Settings (action_settings) → membuka PengaturanActivity
    -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@android:drawable/ic_menu_info_details"
        app:title="Cari item.."
        app:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        ChipGroup: Filter kategori katalog (Aquarium / Makanan / Aksesoris).
        - app:singleSelection="true": Hanya 1 chip yang bisa aktif/terpilih sekaligus
        - app:selectionRequired="true": Wajib ada 1 chip yang selalu terpilih (tidak bisa kosong)
        - Listener perubahan chip ada di MainActivity.kt → chipGroupKategori.setOnCheckedStateChangeListener
        - Saat chip berubah, replaceFragment() dipanggil untuk ganti isi fragment_container
    -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupKategori"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_group"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:chipSpacingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAquarium"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Aquarium"
            android:textColor="@color/white"
            app:checkedIconTint="@color/white"
            app:chipBackgroundColor="@color/dark_blue3" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMakanan"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Makanan"
            android:textColor="@color/white"
            app:checkedIconTint="@color/white"
            app:chipBackgroundColor="@color/dark_blue3" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAksesoris"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aksesoris"
            android:textColor="@color/white"
            app:checkedIconTint="@color/white"
            app:chipBackgroundColor="@color/dark_blue3" />

    </com.google.android.material.chip.ChipGroup>

    <!--
        =========================================================================
        CONTAINER LAYOUT (FRAMELAYOUT: fragment_container)
        =========================================================================
        Wadah dinamis untuk menampung Fragment (AquariumFragment, MakananFragment,
        AksesorisFragment, KeranjangFragment, atau StatusPesananFragment).
        Isi di dalam FrameLayout ini diganti secara bergantian lewat fungsi replaceFragment()
        di MainActivity.kt menggunakan FragmentManager.
    -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chipGroupKategori" />

    <!--
        BottomNavigationView: Navigasi bawah layar untuk berpindah antar modul utama.
        - app:menu="@menu/bottom_nav_menu": Mendefinisikan item menu (Katalog, Keranjang, Status Pesanan)
        - Listener klik ada di MainActivity.kt → bottomNavView.setOnItemSelectedListener
        - ChipGroup VISIBLE saat tab Katalog, GONE saat tab lainnya
        - Juga berperan sebagai anchor Snackbar simpan login (setAnchorView)
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        style="@style/Widget.MaterialComponents.BottomNavigationView.Colored"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:backgroundTint="@color/dark_blue3"
        app:itemIconTint="@color/light_white_menu"
        app:itemTextColor="@color/white"
        app:itemRippleColor="@color/light_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
