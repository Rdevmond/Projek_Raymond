<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Tutorial.TutorialActivity">

    <!--
        ViewPager2: Komponen swipe antar halaman slide tutorial.
        - Diisi oleh TutorialFragmentAdapter (FragmentStateAdapter) di TutorialActivity.kt
        - Menampilkan 4 fragment secara berurutan: Tutorial1 → Tutorial2 → Tutorial3 → Tutorial4
        - Tutorial4Fragment berisi tombol "Mulai" yang menyimpan isTutorialFinished=true
    -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tutorialViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        DotsIndicator (WormDotsIndicator dari library tbuonomo):
        - Menampilkan titik-titik indikator yang berubah sesuai slide ViewPager2 aktif
        - Dihubungkan ke ViewPager2 di TutorialActivity.kt via: dotIndicator.attachTo(tutorialViewPager)
        - Perlu tambahkan dependency di build.gradle: implementation 'com.tbuonomo:dotsindicator:...'
    -->
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dotIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="240dp"
        app:dotsColor="@color/gray"
        app:dotsCornerRadius="8dp"
        app:dotsSize="10dp"
        app:dotsSpacing="6dp"
        app:progressMode="true"
        app:selectedDotColor="@color/dark_blue3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
